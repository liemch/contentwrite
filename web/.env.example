# ContentTechhub Web — Environment Variables

# Admin login (single user)
ADMIN_PASSWORD=your-secure-password
SESSION_SECRET=random-long-secret-min-32-chars

# PostgreSQL (Vercel Postgres / Neon)
DATABASE_URL=postgresql://user:pass@host:5432/contenttechhub?sslmode=require

# NVIDIA NIM — writing model (Hobby: ưu tiên nhanh)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# gpt-oss only: low|medium|high — Hobby nên để low
NVIDIA_REASONING_EFFORT=low

# Web search (bắt buộc cho AI-TFES research)
TAVILY_API_KEY=tvly-...

# Hero image generation
# Flux dùng NVIDIA_API_KEY (black-forest-labs/flux.1-dev)
# Qwen-Image dùng fal.ai (NVIDIA cloud chưa có model này)
FAL_KEY=fal-...

# Auto-write cron (Vercel Cron gửi Authorization: Bearer CRON_SECRET)
CRON_SECRET=random-cron-secret
