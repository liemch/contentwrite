generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  RUNNING
  PUBLISH_READY
  APPROVED
  PUBLISHED
  FAILED
}

enum WorkflowStep {
  RESEARCH
  INSIGHT
  WRITE
  FINALIZE
}

/// Canonical AI-TFES v1.6 state. `status`/`currentStep` remain as UI compatibility fields.
enum WorkflowState {
  IDEA
  MEMORY_CHECKED
  RESEARCHED
  SYNTHESIZED
  INSIGHT_APPROVED
  DECIDED
  PLANNED
  DRAFTED
  EDITORIAL_REVIEWED
  FACT_CHECKED
  FINAL_REVIEWED
  POLISHED
  READER_SIMULATED
  PUBLISH_READY
  APPROVED
  PUBLISHED
  RESEARCH_REQUIRED
  INSIGHT_REJECTED
  MINOR_REVISION_REQUIRED
  MAJOR_REVISION_REQUIRED
  REWRITE_REQUIRED
  FACT_CHECK_FAILED
  READER_SIMULATION_FAILED
  CORRECTION_REQUIRED
  CORRECTED
  RETRACTED
}

enum ArtifactType {
  MEMORY_CHECK
  RESEARCH_BRIEF
  ARTICLE_DRAFT
  REVIEW
  FACT_CHECK
  KNOWLEDGE_RECORD
  PUBLISH_PACKAGE
  READER_SIMULATION
  CORRECTION
}

enum UserRole {
  ADMIN
  EDITOR
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  passwordHash      String
  role              UserRole @default(EDITOR)
  active            Boolean  @default(true)
  /// Số bài được tạo mỗi ngày (TZ VN). 0 = không tạo được.
  dailyArticleLimit Int      @default(3)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  articles          Article[] @relation("ArticleCreator")
  approvedArticles  Article[] @relation("ArticleApprover")
  ownedAutoWrite    AutoWriteConfig[] @relation("AutoWriteOwner")
}

model Article {
  id              String         @id @default(cuid())
  title           String?
  domain          String         @default("engineering")
  topic           String?
  /// manual | auto
  source          String         @default("manual")
  /// blog | field-note | postmortem | adr | internal-brief | thread-qa
  publishFormat   String         @default("blog")
  /// Immutable shape choice for this workflow run; snapshot protects in-flight articles from config edits.
  articleShapeId      String?
  articleShapeVersion String?
  articleShapeSnapshot String?   @db.Text
  openingPattern      String?
  narrativePattern    String?
  status          ArticleStatus  @default(DRAFT)
  currentStep     WorkflowStep?
  /// Backend source of truth for AI-TFES v1.6.
  workflowState   WorkflowState  @default(IDEA)
  workflowRunId   String         @default(uuid())
  /// Optimistic concurrency token; every workflow mutation increments it.
  workflowVersion Int            @default(0)
  /// Semantic content version used by correction/retraction lifecycle.
  contentVersion  String         @default("1.0.0")
  errorMessage    String?

  researchBrief   String?        @db.Text
  insightGate     String?        @db.Text
  draft12         String?        @db.Text
  factCheck       String?        @db.Text
  knowledgeRecord String?        @db.Text
  cleanPublish    String?        @db.Text
  heroBrief       String?        @db.Text
  heroImageUrl    String?
  heroImageModel  String?
  heroImageAlt    String?
  heroPromptUsed  String?        @db.Text
  /// JSON gallery ảnh bài (hero + inline), tối đa 5
  galleryJson     String?        @db.Text
  /// JSON bàn biên tập: fact human verdicts, edit meta
  deskJson        String?        @db.Text

  reviewerNotes   String?        @db.Text
  approvedById    String?
  approvedBy      User?          @relation("ArticleApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  publishedAt     DateTime?

  /// Gợi ý độ dài bản sạch (từ) — null = dùng default Settings
  targetWordCount Int?
  /// CSV flags: table, mermaid, numbered_outline
  avoidFormats    String?

  seriesId        String?
  series          Series?        @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// Thứ tự trong series (1, 2, 3…)
  seriesOrder     Int?

  createdById     String?
  createdBy       User?          @relation("ArticleCreator", fields: [createdById], references: [id], onDelete: SetNull)

  artifacts       WorkflowArtifact[]
  transitions     WorkflowTransition[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([createdById, createdAt])
  @@index([seriesId])
  @@index([publishFormat])
  @@index([status, publishFormat])
  @@index([workflowState, updatedAt])
}

/// Immutable artifact revisions. Never update an existing row; append the next revision.
model WorkflowArtifact {
  id                    String       @id @default(cuid())
  articleId             String
  article               Article      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  workflowRunId         String
  type                  ArtifactType
  revision              Int
  sourceRevision        Int?
  sourceArtifactType    ArtifactType?
  schemaVersion         String       @default("1.0")
  operatingPromptVersion String      @default("1.6")
  domainProfileVersion  String?
  state                 WorkflowState
  content               String       @db.Text
  metadata              Json?
  createdAt             DateTime     @default(now())

  @@unique([articleId, workflowRunId, type, revision])
  @@index([articleId, type, createdAt])
}

/// Append-only audit log for every canonical state transition.
model WorkflowTransition {
  id            String        @id @default(cuid())
  articleId     String
  article       Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  workflowRunId String
  fromState     WorkflowState
  toState       WorkflowState
  action        String
  success       Boolean       @default(true)
  actorId       String?
  details       Json?
  createdAt     DateTime      @default(now())

  @@index([articleId, createdAt])
  @@index([workflowRunId, createdAt])
}

/// Chuyên đề / series — nhóm bài cùng mạch
model Series {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  domain      String    @default("engineering")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles    Article[]
}

/// Digest tuần — tổng hợp insight từ bài điểm cao đã publish
model Digest {
  id          String    @id @default(cuid())
  title       String
  /// YYYY-WW hoặc ISO week label
  weekLabel   String
  domain      String?   // null = mixed
  body        String    @db.Text
  /// JSON: [{ articleId, title, score }]
  sourceJson  String?   @db.Text
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([weekLabel])
  @@index([status])
}

model KnowledgeRecord {
  id           String   @id @default(cuid())
  articleId    String   @unique
  title        String
  domain       String
  category     String?
  keywords     String?
  coreMessage  String?  @db.Text
  editorialScore Int?
  evergreen    Int?
  currentVersion String   @default("1.0.0")
  retractionStatus String @default("none")
  correctionHistory String? @db.Text
  lastVerifiedAt DateTime?
  nextFreshnessReviewAt DateTime?
  publishedAt  DateTime @default(now())
}

/// Singleton cấu hình auto-write (id = "default")
model AutoWriteConfig {
  id               String    @id @default("default")
  enabled          Boolean   @default(false)
  /// interval = mỗi N giờ | daily = mỗi ngày lúc preferredHour
  scheduleMode     String    @default("daily")
  intervalHours    Int       @default(24)
  preferredHour    Int       @default(9)
  timezone         String    @default("Asia/Ho_Chi_Minh")
  /// engineering | soft-skills | product | ai-ml | security | rotate
  domain           String    @default("engineering")
  useSeedTopics    Boolean   @default(true)
  customTopics     String?   @db.Text
  /// Seed bổ sung / ghi đè vận hành — không cần sửa file Domain Profile
  seedTopicsEngineering String? @db.Text
  seedTopicsSoftSkills  String? @db.Text
  maxPendingReview Int       @default(3)
  /// Mặc định số từ bản sạch khi tạo bài / auto-write
  defaultTargetWordCount Int  @default(1200)
  /// Mặc định tránh format (CSV): table, mermaid, numbered_outline
  defaultAvoidFormats String? @default("table")
  /// User sở hữu bài auto-write (thường là admin)
  ownerUserId      String?
  ownerUser        User?     @relation("AutoWriteOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  lastRunAt        DateTime?
  nextRunAt        DateTime?
  lastError        String?   @db.Text
  lastArticleId    String?
  lastDomain       String?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
}

/// Override nội dung file AI-TFES (.md) — runtime ưu tiên DB hơn content/ai-tfes trên disk
model TfesDocument {
  id        String   @id @default(cuid())
  /// Đường dẫn tương đối, vd. 04-Domain-Profiles/engineering.md
  path      String   @unique
  content   String   @db.Text
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Editable article-shape policy. Definition is snapshotted onto Article when selected.
model ArticleShapeProfile {
  id                String   @id
  version           String   @default("1.0")
  labelVi           String
  fit               String   @db.Text
  definitionJson    Json
  active            Boolean  @default(true)
  weight            Int      @default(10)
  cooldownArticles  Int      @default(4)
  compatibleFormats String   @default("blog")
  domains           String   @default("*")
  insightKinds      String   @default("*")
  updatedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([active, updatedAt])
}
