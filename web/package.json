{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first' next dev",
    "prebuild": "node scripts/sync-tfes.mjs",
    "build": "npm run db:generate && next build",
    "vercel-build": "npm run build",
    "postinstall": "npm run db:generate",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 20",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run db:validate && npm run typecheck && npm run test && npm run lint:ci && npm run build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:migrate": "npm run db:migrate:dev",
    "db:push": "node -e \"console.warn('DEPRECATED: db:push bypasses versioned migrations. Use db:migrate:dev (local) or db:migrate:deploy (staging/prod).')\" && prisma db push",
    "db:report:series-owners": "node scripts/report-series-without-owner.mjs",
    "db:report:remediation": "node scripts/report-remediation-metrics.mjs",
    "db:seed-admin": "node scripts/seed-admin.mjs",
    "db:add-gallery": "node scripts/add-gallery-json.mjs",
    "db:add-desk": "node scripts/add-desk-json.mjs",
    "deploy:precheck": "npm run db:validate && npm run db:migrate:status",
    "deploy:migrate": "npm run db:migrate:deploy",
    "deploy:build": "npm run db:generate && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jose": "^6.2.5",
    "next": "16.2.12",
    "openai": "^7.1.0",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
